# RM-AgenticAI-LangGraph Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS
# =============================================================================
# Google Cloud API key for Gemini LLM
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Maximum concurrent workflow executions
MAX_CONCURRENT=5

# =============================================================================
# MODEL PATHS
# =============================================================================
# Path to trained ML models
MODEL_PATH=data/models

# Risk model filename
RISK_MODEL_FILE=risk_model.pkl

# Goal model filename
GOAL_MODEL_FILE=goal_model.pkl

# =============================================================================
# DATA PATHS
# =============================================================================
# Path to data files
DATA_PATH=data

# Product catalog file
PRODUCT_CATALOG=products.csv

# Prospect data file
PROSPECT_DATA=prospects.csv

# =============================================================================
# LLM CONFIGURATION
# =============================================================================
# Gemini model name
LLM_MODEL=gemini-pro

# Temperature for LLM responses (0.0 - 1.0)
LLM_TEMPERATURE=0.3

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=2048

# Timeout for LLM calls (seconds)
LLM_TIMEOUT=30

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# LLM response cache TTL (seconds)
LLM_CACHE_TTL=300

# ML prediction cache TTL (seconds)
ML_CACHE_TTL=3600

# =============================================================================
# STREAMLIT SETTINGS
# =============================================================================
# Server port
STREAMLIT_PORT=8501

# Enable dark mode
STREAMLIT_DARK_MODE=false
